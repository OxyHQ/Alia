{
  "name": "alia-cowork",
  "version": "1.0.0",
  "description": "Alia Cowork - scoped local execution for Windows and Linux Xorg",
  "main": "dist/main/index.js",
  "author": "Alia",
  "license": "MIT",
  "scripts": {
    "start": "gulp dev",
    "dev": "gulp dev",
    "dev:fresh": "gulp clean:all && gulp dev",
    "build": "gulp build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:fresh": "gulp clean && gulp build",
    "clean": "gulp clean",
    "clean:all": "gulp clean:all",
    "kill": "gulp kill-electron",
    "postinstall": "playwright install chromium",
    "package": "bun run build && electron-builder",
    "dist": "bun run build && electron-builder --publish never"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3.7.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@oxy.so/bloom": "15.0.0",
    "@oxy.so/core": "6.0.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.58.0",
    "openai": "^6.46.0",
    "playwright": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.21.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/gulp": "^4.0.18",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "esbuild-plugin-html": "^1.0.0",
    "esbuild-plugin-postcss2": "^0.1.2",
    "gulp": "^5.0.1",
    "gulp-esbuild": "^0.15.0",
    "gulp-postcss": "^10.0.0",
    "postcss": "^8.5.30",
    "postcss-import": "^17.0.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
