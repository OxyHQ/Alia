# =============================================================================
# Alia API — Runtime environment variables
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Legend:
#   [SECRET]   — sensitive value; inject via your secrets manager (AWS Secrets
#                Manager / SSM Parameter Store), never hard-code in manifests.
#   [required] — the server starts without it, but the related feature is
#                disabled or will error when used.
#
# PostgreSQL is the ONLY hard dependency: the process EXITS at boot without
# DATABASE_URL. Everything else degrades. The container listens even if MongoDB /
# Redis / LiveKit / Stripe are unreachable; readiness (/health/ready) asks
# PostgreSQL a real question and liveness (/health/live) always returns 200 while
# the process runs.
#
# Upstream model credentials are NOT configured here. They live in the
# `provider_keys` table in PostgreSQL. There is no gateway service — see the
# GATEWAY_API_URL note below before setting it.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE SERVER
# -----------------------------------------------------------------------------
# Port the HTTP/WebSocket server listens on. Set it explicitly: the code falls
# back to 4150 while the Dockerfile health check and EXPOSE use 3001.
PORT=3001
# Node environment. Also selects the MongoDB database name: `alia-{NODE_ENV}`.
NODE_ENV=production
# Log level for pino: trace | debug | info | warn | error (default: info in prod).
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL (REQUIRED; the process exits at boot without it)
# -----------------------------------------------------------------------------
# Full connection string including the database name. Migrations run through
# `bun run --filter @alia/api db:migrate`, which requires --target-database.
DATABASE_URL=postgres://localhost:5432/alia      # [SECRET][required]

# -----------------------------------------------------------------------------
# DATABASE — MongoDB (only for the domains not yet ported to PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string WITHOUT the database name (db name is `alia-{NODE_ENV}`).
# Connected in the background with retry; the server starts without it and the
# routes still backed by a Mongoose model return 500 until it connects.
# MONGODB_URI=mongodb://localhost:27017           # [SECRET]
# PEM CA certificate for a managed database requiring TLS (optional). Read only
# as the fallback for REDIS_CA_CERT — see lib/redis.ts.
# CA_CERT=                                        # [SECRET]

# -----------------------------------------------------------------------------
# REDIS — task queue, rate limiting, Socket.IO adapter (optional)
# -----------------------------------------------------------------------------
# If unset: BullMQ async tasks run inline, rate limiting fails open.
# Local: redis://localhost:6379   Managed TLS: rediss://user:pass@host:port
# REDIS_URL=redis://localhost:6379                # [SECRET]
# PEM CA certificate for Redis over TLS (falls back to CA_CERT if unset).
# REDIS_CA_CERT=                                  # [SECRET]

# -----------------------------------------------------------------------------
# PUBLIC URLs (CORS, auth redirects, link generation)
# -----------------------------------------------------------------------------
# Web app origin (added to the CORS allow-list).
WEB_URL=https://alia.onl
# Mobile app URL for auth redirects (defaults to WEB_URL).
# APP_URL=https://alia.onl
# Public URL of this API (used to build auth links).
# API_BASE_URL=https://api.alia.onl
# Public URL of this API used by agent browser sessions/tools.
# ALIA_API_URL=https://api.alia.onl

# -----------------------------------------------------------------------------
# AUTHENTICATION & INTERNAL SECRETS
# -----------------------------------------------------------------------------
# OxyHQ identity API base URL (auth/token verification).
OXY_API_URL=https://api.oxy.so
# Shared HMAC secret gating the internal providers module.
# Generate: openssl rand -hex 32
SERVICE_SECRET=                                   # [SECRET][required]
# AES-256-GCM key (64-char hex) encrypting stored OAuth tokens.
# Required for OAuth integrations. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=                             # [SECRET]

# -----------------------------------------------------------------------------
# GATEWAY_API_URL — LEAVE UNSET
# -----------------------------------------------------------------------------
# There is no gateway service; `packages/alia-gateway` was deleted. Setting this
# alongside SERVICE_SECRET flips lib/gateway-client.ts into remote mode and every
# model call goes to an HTTP service that does not exist.
#
# lib/tools/gateway-admin.ts, the second reader, is gone as of #139 workstream 9.
# The name survives for one reason only: gateway-client.ts:33 still reads it, and
# that module is the seam the Relay client replaces (#139 workstream 8). The
# variable retires with the seam, not before.
# GATEWAY_API_URL=

# -----------------------------------------------------------------------------
# RELAY CLIENT — ALL OR NOTHING, AND CURRENTLY NOTHING
# -----------------------------------------------------------------------------
# ALIA_RELAY_CLIENT_ENABLED is the migration flag for epic #139. Exactly the
# literal `true` enables it; `1`, `TRUE` and everything else do not. It is unset
# in every environment, and `Oxy API -> Relay` is not mounted yet, so setting it
# today points the client at a hole.
#
# When it IS set, three things happen at boot (#139 ws8):
#
#   1. the process REFUSES TO START unless all six variables below describe a
#      principal the Oxy contract accepts AND an approved Relay origin —
#      lib/inference/relay-boot-check.ts. Half-configured has to be off rather
#      than a service that accepts requests and then fails every model call;
#   2. the process REFUSES TO START if a direct provider route is still
#      configured — GATEWAY_API_URL, or any <PROVIDER>_API_KEY —
#      lib/inference/direct-provider-guard.ts. The only configuration the two
#      checks admit together is: Relay configured, provider configuration absent;
#   3. outbound requests to provider API hosts are refused inside the process —
#      lib/inference/provider-egress-policy.ts. Relay, Oxy and every product
#      dependency are unaffected.
#
# /health and /health/ready also start reporting Relay connectivity. With the
# flag off they report `disabled`, which neither degrades the snapshot nor blocks
# readiness, so the status code either route returns is unchanged.
# ALIA_RELAY_CLIENT_ENABLED=true
# Oxy account that owns the workload and is charged for it (never an end user).
# ALIA_RELAY_ACCOUNT_ID=
# The Oxy Application and the ApplicationCredential this deployment presents.
# ALIA_RELAY_APPLICATION_ID=
# ALIA_RELAY_CREDENTIAL_ID=
# Which environment the CREDENTIAL was issued into: development | staging |
# production. It is checked against NODE_ENV on a real deployment and must match
# — a staging credential on a production task bills test traffic to the
# production account, and no later query separates it out again.
# ALIA_RELAY_ENVIRONMENT=production
# Comma-separated inference scopes. `inference:invoke` is required; without it
# the far end refuses every request with insufficient_scope.
# ALIA_RELAY_INFERENCE_SCOPES=inference:invoke
# Where inference is sent. PINNED: a production or staging process accepts only
# an approved Oxy origin (lib/inference/relay-endpoint.ts, RELAY_ALLOWED_ORIGINS)
# and refuses to start on anything else, including loopback. A development
# process may additionally point at localhost, which is the ONLY relaxation and
# is keyed on NODE_ENV rather than on a second variable.
# RELAY_BASE_URL=https://api.oxy.so

# -----------------------------------------------------------------------------
# OBJECT STORAGE — S3 / DigitalOcean Spaces / compatible (required for uploads)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=                                # [SECRET][required]
AWS_SECRET_ACCESS_KEY=                            # [SECRET][required]
AWS_S3_BUCKET=bucket-alia
# Custom S3 endpoint for non-AWS providers (e.g. https://ams3.digitaloceanspaces.com).
# AWS_ENDPOINT_URL=
# Public CDN base URL for stored objects (defaults to the bucket URL).
# AWS_CDN_URL=

# -----------------------------------------------------------------------------
# BILLING — Stripe (optional; billing routes error until set)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=                              # [SECRET]
# STRIPE_WEBHOOK_SECRET=                          # [SECRET]

# -----------------------------------------------------------------------------
# LIVEKIT — realtime voice/video (optional)
# -----------------------------------------------------------------------------
# LIVEKIT_URL=wss://livekit.oxy.so
# LIVEKIT_INTERNAL_URL=wss://livekit.oxy.so       # defaults to LIVEKIT_URL
# LIVEKIT_API_KEY=                                # [SECRET]
# LIVEKIT_API_SECRET=                             # [SECRET]

# -----------------------------------------------------------------------------
# WEB PUSH — browser notifications (optional)
# -----------------------------------------------------------------------------
# Generate a key pair: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=                              # [SECRET]
# VAPID_SUBJECT=mailto:contact@alia.onl

# -----------------------------------------------------------------------------
# INTEGRATIONS SERVICE (MCP tools / channel proxy) — optional
# -----------------------------------------------------------------------------
# INTEGRATIONS_URL=http://integrations:3005
# INTEGRATIONS_SECRET=                            # [SECRET]  openssl rand -hex 32

# -----------------------------------------------------------------------------
# DOCKER HOST (agent container system) — optional
# -----------------------------------------------------------------------------
# DOCKER_HOST_URL=http://docker-host:9090
# DOCKER_HOST_SECRET=                             # [SECRET]  openssl rand -hex 32
# CONTAINER_POOL_SIZE=4
# AGENT_MAX_DURATION_MS=600000
# AUTONOMY_APPROVAL_TIMEOUT_MS=60000
# AUTONOMY_ROLLBACK_WINDOW_MINUTES=30

# -----------------------------------------------------------------------------
# CHANNEL BOTS — per-channel auth (x-channel-bot-secret). Optional.
# Bot tokens/platform creds live in the integrations service; the API only
# needs the matching per-channel secret to validate inbound requests.
# Generate each: openssl rand -hex 32
# -----------------------------------------------------------------------------
# --- Telegram ---
# TELEGRAM_BOT_TOKEN=                             # [SECRET]
# TELEGRAM_BOT_SECRET=                            # [SECRET]
# --- Discord ---
# DISCORD_BOT_TOKEN=                              # [SECRET]
# DISCORD_BOT_SECRET=                             # [SECRET]
# DISCORD_APP_ID=
# DISCORD_PUBLIC_KEY=
# --- Slack ---
# SLACK_BOT_TOKEN=                                # [SECRET]
# SLACK_SIGNING_SECRET=                           # [SECRET]
# SLACK_BOT_SECRET=                               # [SECRET]
# --- WhatsApp ---
# WHATSAPP_ACCESS_TOKEN=                          # [SECRET]
# WHATSAPP_APP_SECRET=                            # [SECRET]
# WHATSAPP_BOT_SECRET=                            # [SECRET]
# WHATSAPP_VERIFY_TOKEN=                          # [SECRET]
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GATEWAY_URL=
# WHATSAPP_GATEWAY_SECRET=                        # [SECRET]
# --- Signal ---
# SIGNAL_CLI_URL=
# SIGNAL_PHONE_NUMBER=
# SIGNAL_BOT_SECRET=                              # [SECRET]

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (account linking) — optional
# -----------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=                     # [SECRET]
