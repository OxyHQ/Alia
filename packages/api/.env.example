# =============================================================================
# Alia API — Runtime environment variables
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Legend:
#   [SECRET]   — sensitive value; inject via your secrets manager (AWS Secrets
#                Manager / SSM Parameter Store), never hard-code in manifests.
#   [required] — the server starts without it, but the related feature is
#                disabled or will error when used.
#
# PostgreSQL and the Oxy inference service credential are hard boot dependencies.
# The container listens only after both validate. Redis / LiveKit / Stripe may
# degrade their own features; readiness asks PostgreSQL a real question and
# liveness always returns 200 while the process runs.
#
# Upstream model credentials are NOT configured here or read by Alia. Kaana owns
# hosted provider credentials in its PostgreSQL database. The credential below
# authenticates Alia to Oxy; it is not a provider credential.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE SERVER
# -----------------------------------------------------------------------------
# Port the HTTP/WebSocket server listens on. Set it explicitly: the code falls
# back to 4150 while the Dockerfile health check and EXPOSE use 3001.
PORT=3001
# Node environment. Controls production defaults such as structured logging.
NODE_ENV=production
# Log level for pino: trace | debug | info | warn | error (default: info in prod).
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL (REQUIRED; the process exits at boot without it)
# -----------------------------------------------------------------------------
# Full connection string including the database name. Migrations run through
# `bun run --filter @alia/api db:migrate`, which requires --target-database.
DATABASE_URL=postgres://localhost:5432/alia      # [SECRET][required]

# PEM CA certificate for a managed database requiring TLS (optional). Read only
# as the fallback for REDIS_CA_CERT — see lib/redis.ts.
# CA_CERT=                                        # [SECRET]

# -----------------------------------------------------------------------------
# REDIS — task queue, rate limiting, Socket.IO adapter (optional)
# -----------------------------------------------------------------------------
# If unset: BullMQ async tasks run inline, rate limiting fails open.
# Local: redis://localhost:6379   Managed TLS: rediss://user:pass@host:port
# REDIS_URL=redis://localhost:6379                # [SECRET]
# PEM CA certificate for Redis over TLS (falls back to CA_CERT if unset).
# REDIS_CA_CERT=                                  # [SECRET]

# -----------------------------------------------------------------------------
# PUBLIC URLs (CORS, auth redirects, link generation)
# -----------------------------------------------------------------------------
# Web app origin (added to the CORS allow-list).
WEB_URL=https://alia.onl
# Mobile app URL for auth redirects (defaults to WEB_URL).
# APP_URL=https://alia.onl
# Public URL of this API (used to build auth links).
# API_BASE_URL=https://api.alia.onl
# Public URL of this API used by agent browser sessions/tools.
# ALIA_API_URL=https://api.alia.onl

# -----------------------------------------------------------------------------
# AUTHENTICATION & INTERNAL SECRETS
# -----------------------------------------------------------------------------
# OxyHQ identity API base URL (auth/token verification).
OXY_API_URL=https://api.oxy.so
# Shared HMAC secret for explicitly internal service-authenticated routes and tools.
# Generate: openssl rand -hex 32
SERVICE_SECRET=                                   # [SECRET][required]
# AES-256-GCM key (64-char hex) encrypting stored OAuth tokens.
# Required for OAuth integrations. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=                             # [SECRET]

# -----------------------------------------------------------------------------
# HOSTED INFERENCE THROUGH OXY — REQUIRED
# -----------------------------------------------------------------------------
# Alia uses @oxyhq/core's OxyInferenceClient. It authenticates only to Oxy;
# Oxy resolves the application identity, routing profile and authorised Kaana
# routes. Alia never receives a Kaana edge-signing key, provider credential or
# direct Kaana URL.
#
# Three things happen at every boot:
#
#   1. the process REFUSES TO START unless OXY_API_URL and both application
#      credential values are present and the Oxy origin is approved —
#      lib/inference/oxy-inference-boot-check.ts;
#   2. the process REFUSES TO START if a direct provider route is
#      configured — GATEWAY_API_URL, or any <PROVIDER>_API_KEY —
#      lib/inference/direct-provider-guard.ts;
#   3. outbound requests to provider API hosts are refused inside the process —
#      lib/inference/provider-egress-policy.ts.
#
# The ApplicationCredential's own secret material — the public key (oxy_dk_...)
# and its secret. They are exchanged with OXY_API_URL for a short-lived service
# token and never travel on a request themselves; @oxyhq/core owns the caching
# and refresh (lib/inference/oxy-inference-credential.ts). Issue one credential
# per environment. Oxy derives account/application/credential IDs from it; do
# not duplicate those IDs in Alia configuration.
# NOT only for inference, despite the name: lib/oxy-service-client.ts presents
# the same credential for identity lookups, because POST /users/by-ids is
# CSRF-gated and Oxy admits a write only with a bearer. Unset, every agent name,
# handle and avatar in the product renders blank.
# OXY_SERVICE_API_KEY=                            # [SECRET]
# OXY_SERVICE_API_SECRET=                         # [SECRET]
# One-shot native-product bootstrap only. This points at a mode-0600 file; the
# bearer itself is never stored in env, argv, logs or this repository.
# OXY_BOOTSTRAP_ACCESS_TOKEN_FILE=/run/secrets/oxy-bootstrap-access-token
# ALLOW_LOOPBACK_OXY_BOOTSTRAP=0                  # dry-run only; never APPLY/ROLLBACK

# -----------------------------------------------------------------------------
# OBJECT STORAGE — S3 / DigitalOcean Spaces / compatible (required for uploads)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=                                # [SECRET][required]
AWS_SECRET_ACCESS_KEY=                            # [SECRET][required]
AWS_S3_BUCKET=bucket-alia
# Custom S3 endpoint for non-AWS providers (e.g. https://ams3.digitaloceanspaces.com).
# AWS_ENDPOINT_URL=
# Public CDN base URL for stored objects (defaults to the bucket URL).
# AWS_CDN_URL=

# -----------------------------------------------------------------------------
# BILLING — Stripe (optional; billing routes error until set)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=                              # [SECRET]
# STRIPE_WEBHOOK_SECRET=                          # [SECRET]

# -----------------------------------------------------------------------------
# LIVEKIT — realtime voice/video (optional)
# -----------------------------------------------------------------------------
# LIVEKIT_URL=wss://livekit.oxy.so
# LIVEKIT_INTERNAL_URL=wss://livekit.oxy.so       # defaults to LIVEKIT_URL
# LIVEKIT_API_KEY=                                # [SECRET]
# LIVEKIT_API_SECRET=                             # [SECRET]

# -----------------------------------------------------------------------------
# WEB PUSH — browser notifications (optional)
# -----------------------------------------------------------------------------
# Generate a key pair: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=                              # [SECRET]
# VAPID_SUBJECT=mailto:contact@alia.onl

# -----------------------------------------------------------------------------
# INTEGRATIONS SERVICE (MCP tools / channel proxy) — optional
# -----------------------------------------------------------------------------
# INTEGRATIONS_URL=http://integrations:3005
# INTEGRATIONS_SECRET=                            # [SECRET]  openssl rand -hex 32

# -----------------------------------------------------------------------------
# DOCKER HOST (agent container system) — optional
# -----------------------------------------------------------------------------
# DOCKER_HOST_URL=http://docker-host:9090
# DOCKER_HOST_SECRET=                             # [SECRET]  openssl rand -hex 32
# CONTAINER_POOL_SIZE=4
# AGENT_MAX_DURATION_MS=600000
# AUTONOMY_APPROVAL_TIMEOUT_MS=60000
# AUTONOMY_ROLLBACK_WINDOW_MINUTES=30

# -----------------------------------------------------------------------------
# CHANNEL BOTS — per-channel auth (x-channel-bot-secret). Optional.
# Bot tokens/platform creds live in the integrations service; the API only
# needs the matching per-channel secret to validate inbound requests.
# Generate each: openssl rand -hex 32
# -----------------------------------------------------------------------------
# --- Telegram ---
# TELEGRAM_BOT_TOKEN=                             # [SECRET]
# TELEGRAM_BOT_SECRET=                            # [SECRET]
# --- Discord ---
# DISCORD_BOT_TOKEN=                              # [SECRET]
# DISCORD_BOT_SECRET=                             # [SECRET]
# DISCORD_APP_ID=
# DISCORD_PUBLIC_KEY=
# --- Slack ---
# SLACK_BOT_TOKEN=                                # [SECRET]
# SLACK_SIGNING_SECRET=                           # [SECRET]
# SLACK_BOT_SECRET=                               # [SECRET]
# --- WhatsApp ---
# WHATSAPP_ACCESS_TOKEN=                          # [SECRET]
# WHATSAPP_APP_SECRET=                            # [SECRET]
# WHATSAPP_BOT_SECRET=                            # [SECRET]
# WHATSAPP_VERIFY_TOKEN=                          # [SECRET]
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GATEWAY_URL=
# WHATSAPP_GATEWAY_SECRET=                        # [SECRET]
# --- Signal ---
# SIGNAL_CLI_URL=
# SIGNAL_PHONE_NUMBER=
# SIGNAL_BOT_SECRET=                              # [SECRET]

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (account linking) — optional
# -----------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=                     # [SECRET]

# -----------------------------------------------------------------------------
# SYRA (syra.fm) — where a generated show is published
# -----------------------------------------------------------------------------
# A show series IS a podcast on Syra, so this is not optional in the way a
# feature flag is: with it unset the API falls back to the production host,
# which is right for every real deployment and wrong for a staging one.
# No secret. Syra authenticates the CALLER's own Oxy token, plus a single-use
# ingest ticket the worker redeems — there is no service credential to hold.
# SYRA_API_URL=https://api.syra.fm
