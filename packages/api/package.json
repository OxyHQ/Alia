{
  "name": "@alia/api",
  "version": "1.0.0",
  "description": "API de producto de Alia con inferencia hospedada exclusivamente a través de Kaana",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "trustedDependencies": [
    "ffmpeg-static"
  ],
  "scripts": {
    "db:check-locks": "oxy-db-check-migration-locks --migrations=drizzle --after=103 --hot-tables=agents,conversations,messages,organization_members,organizations,subscriptions,user_credits",
    "dev": "bun --watch src/index.ts",
    "build": "bun build.ts",
    "start": "bun dist/index.js",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "test:bun-runtime": "bun test src/lib/__tests__/websocket-upgrades.test.ts",
    "scan:credentials": "bun src/scripts/scan-credential-history.ts",
    "migrate:oxy-files": "bun src/scripts/migrate-to-oxy-files.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.84",
    "@ai-sdk/provider": "3.0.14",
    "@aws-sdk/client-ec2": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@clarity.surf/sdk": "^0.4.0",
    "@crowdsource.you/contracts": "1.1.0",
    "@crowdsource.you/core": "3.0.0",
    "@kaana.ai/contracts": "6.1.0",
    "@kaana.ai/sdk": "3.1.0",
    "@oxy.so/contracts": "5.0.0",
    "@oxy.so/core": "6.0.0",
    "@oxy.so/db": "^1.3.0",
    "@oxy.so/mcp": "1.3.1",
    "@oxy.so/utils": "^1.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@syra.fm/sdk": "^0.21.0",
    "adm-zip": "^0.6.1",
    "ai": "6.0.225",
    "bullmq": "^5.80.2",
    "cors": "^2.8.6",
    "cron-parser": "4.9.0",
    "drizzle-orm": "0.45.4",
    "esbuild": "^0.28.2",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "postgres": "3.4.9",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2",
    "tar": "^7.5.22",
    "unpdf": "1.9.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "4.0.38",
    "@types/adm-zip": "^0.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^25.9.5",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "0.31.11",
    "gpt-tokenizer": "^4.0.3",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
