{
  "name": "@alia.onl/server",
  "version": "1.1.1",
  "description": "Alia's server-side streaming client \u2014 one typed event stream for a backend that calls Alia's product API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Alia.git",
    "directory": "packages/alia-server"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check:entrypoints": "node scripts/check-entrypoints.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "alia",
    "oxy",
    "sse",
    "streaming",
    "chat"
  ],
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "typesVersions": {
    "*": {
      "internal": [
        "./dist/internal.d.cts"
      ]
    }
  }
}
