# ================================
# EXPO APP CONFIGURATION
# ================================
# API server URL
EXPO_PUBLIC_API_URL=http://localhost:4150

# ================================
# PERFORMANCE OPTIMIZATIONS
# ================================
# Tree shaking removes unused code from production bundles (Expo SDK 52+)
EXPO_UNSTABLE_TREE_SHAKING=1
EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1

# ================================
# NOTES
# ================================
# - Copy this file to .env and fill in your values
# - EXPO_PUBLIC_ prefix exposes vars to the client bundle
# - Never put secrets in EXPO_PUBLIC_ variables
# - Production values are not read from a file: src/shared/platform/config.ts hardcodes the
#   per-environment API URLs and EXPO_PUBLIC_API_URL overrides them.
