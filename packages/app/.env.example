# ================================
# EXPO APP CONFIGURATION
# ================================
# API server URL
EXPO_PUBLIC_API_URL=http://localhost:4150

# Telegram bot username (for login deep link)
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=alia_onlbot

# Syra (syra.fm) — where a show's episodes are actually served from.
# Deliberately NOT tied to EXPO_PUBLIC_API_URL: running against a local API
# still plays episodes from the real Syra, because that is where the podcast a
# series created exists.
EXPO_PUBLIC_SYRA_API_URL=https://api.syra.fm

# ================================
# PERFORMANCE OPTIMIZATIONS
# ================================
# Tree shaking removes unused code from production bundles (Expo SDK 52+)
EXPO_UNSTABLE_TREE_SHAKING=1
EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1

# ================================
# NOTES
# ================================
# - Copy this file to .env and fill in your values
# - EXPO_PUBLIC_ prefix exposes vars to the client bundle
# - Never put secrets in EXPO_PUBLIC_ variables
# - Production values are not read from a file: lib/config.ts hardcodes the
#   per-environment API URLs and EXPO_PUBLIC_API_URL overrides them.
