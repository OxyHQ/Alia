{
  "name": "@alia/integrations",
  "version": "1.0.0",
  "private": true,
  "description": "Unified integrations service \u2014 messaging gateways, bots, browser, terminal",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@oxyhq/core": "^23.2.1",
    "@oxyhq/db": "^0.1.2",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "@whiskeysockets/baileys": "~6.7.23",
    "axios": "^1.18.1",
    "discord.js": "^14.26.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.2",
    "express": "^4.22.2",
    "node-pty": "^1.1.0",
    "playwright": "^1.61.1",
    "postgres": "3.4.9",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "typescript": "^5.9.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "vitest": "^4.1.10"
  }
