{
  "name": "@alia-codea/cli",
  "version": "3.0.0",
  "description": "Codea CLI - AI coding assistant for your terminal by Alia",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "codea": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "keywords": [
    "ai",
    "cli",
    "coding",
    "assistant",
    "terminal",
    "alia",
    "codea"
  ],
  "author": "Alia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Alia.git",
    "directory": "packages/alia-codea-cli"
  },
  "dependencies": {
    "@oxy.so/core": "6.0.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^18.1.0",
    "marked-terminal": "^7.3.0",
    "openai": "^6.46.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
