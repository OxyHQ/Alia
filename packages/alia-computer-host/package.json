{
  "name": "@alia/computer-host",
  "version": "0.1.0",
  "description": "The agents' computer: one gVisor-sandboxed container per actor and a shared, proxied browser, behind a control API only Alia's API can call",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.22.2",
    "pino": "^10.3.1",
    "playwright-core": "1.61.1",
    "postgres": "3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@oxy.so/core": "4.5.0-oxy-one.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
