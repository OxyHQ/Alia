{
  "name": "alia-monorepo",
  "version": "1.0.0",
  "description": "Monorepo para Alia - plataforma de IA con app (web+mobile) y API",
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "workspaces": [
    "packages/api",
    "packages/app",
    "packages/alia-chat",
    "packages/alia-server",
    "packages/alia-canvas",
    "packages/integrations",
    "packages/alia-codea",
    "packages/alia-codea/webview-ui",
    "packages/alia-cowork",
    "packages/alia-codea-cli",
    "packages/alia-computer-host"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:app": "bun run --filter @alia/app dev -- --clear --tunnel",
    "dev:api": "bun run --filter @alia/api dev",
    "dev:canvas": "bun run --filter alia-canvas dev",
    "dev:integrations": "bun run --filter @alia/integrations dev",
    "dev:codea": "bun run --filter alia-codea dev",
    "dev:cowork": "bun run --filter alia-cowork dev",
    "build": "bun run --filter '*' build",
    "build:app": "bun run --filter @alia/app build",
    "build:api": "bun run --filter @alia/api build",
    "build:canvas": "bun run --filter alia-canvas build",
    "build:integrations": "bun run --filter @alia/integrations build",
    "start:app": "bun run --filter @alia/app start",
    "start:api": "bun run --filter @alia/api start",
    "start:canvas": "bun run --filter alia-canvas preview",
    "start:integrations": "bun run --filter @alia/integrations start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "doctor:oxy": "oxy-doctor --ci",
    "lint:canvas": "bun run --filter alia-canvas lint",
    "android": "bun run --filter @alia/app android",
    "ios": "bun run --filter @alia/app ios",
    "web": "bun run --filter @alia/app web"
  },
  "keywords": [
    "monorepo",
    "ai",
    "nextjs",
    "expo",
    "api",
    "alia"
  ],
  "author": "",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@oxy.so/bloom": "15.46.0",
    "@oxy.so/core": "7.5.0",
    "@oxy.so/services": "13.1.0",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "58.0.2",
    "react-native-screens": "4.30.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-keyboard-controller": "1.22.7",
    "expo": "58.0.19",
    "expo-blur": "58.0.5",
    "expo-constants": "58.0.13",
    "expo-file-system": "58.0.11",
    "expo-font": "58.0.10",
    "expo-image": "58.0.17",
    "@react-native-menu/menu": "2.0.0",
    "expo-modules-core": "58.0.26",
    "expo-modules-jsi": "58.0.19",
    "react-native-safe-area-context": "5.10.1",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-rc.0",
    "react-native-css": "3.1.0-rc.0",
    "@oxy.so/core": "7.5.0",
    "@oxy.so/contracts": "6.0.0",
    "@oxy.so/protocol": "1.5.1",
    "@oxy.so/services": "13.0.0",
    "@oxy.so/mcp": "1.4.0"
  }
}
