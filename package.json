{
  "name": "alia-monorepo",
  "version": "1.0.0",
  "description": "Monorepo de Alia: la app (web+móvil). El backend, @gemies/sdk y @gemies/server viven en OxyHQ/Gemies.",
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "workspaces": [
    "packages/app"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:app": "bun run --filter @alia/app dev -- --clear --tunnel",
    "build": "bun run --filter '*' build",
    "build:app": "bun run --filter @alia/app build",
    "start:app": "bun run --filter @alia/app start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "doctor:oxy": "oxy-doctor --ci",
    "i18n:check": "oxy-doctor-i18n --ci",
    "android": "bun run --filter @alia/app android",
    "ios": "bun run --filter @alia/app ios",
    "web": "bun run --filter @alia/app web"
  },
  "keywords": [
    "monorepo",
    "ai",
    "expo",
    "alia"
  ],
  "author": "",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.8.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@oxy.so/bloom": "19.10.1",
    "@oxy.so/core": "7.48.0",
    "@oxy.so/services": "14.19.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "58.0.2",
    "react-native-screens": "4.30.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-keyboard-controller": "1.22.7",
    "expo": "58.0.23",
    "expo-blur": "58.0.5",
    "expo-constants": "58.0.13",
    "expo-file-system": "58.0.11",
    "expo-font": "58.0.10",
    "expo-image": "58.0.17",
    "@react-native-menu/menu": "2.0.0",
    "expo-modules-core": "58.0.26",
    "expo-modules-jsi": "58.0.19",
    "react-native-safe-area-context": "5.10.1",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-rc.0",
    "react-native-css": "3.1.0-rc.0",
    "@oxy.so/core": "7.48.0",
    "@oxy.so/contracts": "6.25.0",
    "@oxy.so/protocol": "1.11.0",
    "@oxy.so/services": "14.19.1",
    "@oxy.so/mcp": "1.4.2"
  }
}
